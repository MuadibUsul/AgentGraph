# ------------------------------------------------------------------ AgentGraph
APP_NAME=AgentGraph
APP_VERSION=3.2.1
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DOCS_ENABLED=true
# Protect /docs and /openapi.json with HTTP Basic (password = ADMIN_TOKEN).
DOCS_REQUIRE_AUTH=true

# --------------------------------------------------------------------- storage
# Docker Compose overrides this to the `db` service automatically.
DATABASE_URL=postgresql+asyncpg://agentgraph:agentgraph@localhost:5432/agentgraph
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Apply sql/init.sql + v2->v3 migration on boot. Keep true for managed Postgres.
AUTO_INIT_DB=true

# ------------------------------------------------------------------------ auth
# Required for /v1/admin/*, the human console and workspace provisioning.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-in-production
API_KEY_PREFIX=ag_
AGENT_KEY_PREFIX=agt_

# ------------------------------------------------------------------ embeddings
# openai | ollama | hash
# `hash` is deterministic offline feature hashing for demos/tests. Use openai
# or an OpenAI-compatible endpoint / local Ollama for production recall.
EMBEDDING_PROVIDER=hash
# Jina free-tier / production example:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_DIMENSIONS=1024
# OPENAI_BASE_URL=https://api.jina.ai/v1
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_BATCH_INTERVAL_SECONDS=5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
# Recommended semantic profile when using an external Ollama host:
OLLAMA_EMBEDDING_MODEL=bge-m3

# ------------------------------------------------------------ blackboard rules
# Default TTL for task/slot leases, reaper cadence and ping-pong threshold.
DEFAULT_TASK_LEASE_SECONDS=60
MAX_TASK_LEASE_SECONDS=3600
LEASE_REAPER_INTERVAL_SECONDS=15
DEFAULT_MAX_RETRIES=3
MAX_REJECT_HISTORY=20
HUMAN_OVERRIDE_DEFAULT_LOCK=true

# --------------------------------------------------------------- retrieval
SEARCH_TOP_K=5
MAX_SEARCH_TOP_K=50
SEMANTIC_THRESHOLD=0.15
DEFAULT_TIMELINE_HOURS=24
MAX_CONTEXT_TIMELINE=50
MAX_CONTEXT_SLOTS=100
MAX_WORKSPACE_MAP_ITEMS=300
MAX_PAGE_SIZE=100

# ----------------------------------------------------------------------- quota
# Per-tier per-workspace hard caps.
FREE_MAX_DOCUMENTS=5000
FREE_MAX_SLOTS=20
DEVELOPER_MAX_DOCUMENTS=50000
DEVELOPER_MAX_SLOTS=100
PRO_MAX_DOCUMENTS=500000
PRO_MAX_SLOTS=1000
MAX_DOCUMENT_CONTENT_CHARS=100000
MAX_STATE_BYTES=100000
MAX_BRIEF_BYTES=32768
MAX_ARTIFACT_CHARS=200000

# --------------------------------------------------------------------- realtime
SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_LIMIT=500
SSE_REVALIDATE_SECONDS=30
SSE_MAX_LIFETIME_SECONDS=3600
EVENT_RETENTION_DAYS=7
AUTO_TIMELINE_EVENTS=true

# --------------------------------------------------------------------- runtime
MCP_ENABLED=true
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
# JSON list. Set these when the API is served behind a custom domain;
# localhost is allowed by default.
MCP_ALLOWED_HOSTS=[]
MCP_ALLOWED_ORIGINS=[]
MCP_DNS_REBINDING_PROTECTION=true
# Only for the stdio MCP process (`python -m app.mcp_server`).
MCP_API_KEY=
MCP_AGENT_NAME=mcp_agent
CORS_ORIGINS=[]

# ------------------------------------------------------- v3.2 proposals/policy
PROPOSALS_ENABLED=true
DEFAULT_PROPOSAL_QUORUM=1
MAX_PROPOSAL_CONTENT_CHARS=100000
PROPOSAL_ARENA_MAX_ENTRIES=20

# --------------------------------------------------------------- v3.2 taint
TAINT_PROPAGATION_ENABLED=true
TAINT_MAX_DEPTH=20
TAINT_UNTRUSTED_SOURCE_DEFAULT=true

# ----------------------------------------------------------- v3.2 retrieval
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_RRF_K=60
HNSW_EF_SEARCH=100

# ------------------------------------------------------- v3.2 human accounts
HUMAN_SESSION_HOURS=12
PASSWORD_HASH_N=16384
PASSWORD_HASH_R=8
PASSWORD_HASH_P=1
HUMAN_LOGIN_MAX_ATTEMPTS_PER_MINUTE=10
HUMAN_SIGNUP_ENABLED=true
SIGNUP_DEFAULT_TIER=free
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------- v3.2 row security
RLS_ENABLED=true
RLS_ROLE=agentgraph_app
RLS_REQUIRE_CONTEXT=false

# ------------------------------------------------------ v3.2 budgets/limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_WINDOW_SECONDS=60
DEFAULT_MONTHLY_TOKEN_BUDGET=10000000
DEFAULT_MONTHLY_COST_BUDGET_USD=1000
DEFAULT_MAX_CONCURRENT_LEASES=100

# ------------------------------------------------------- v3.2 outbound control
OUTBOUND_DISPATCH_INTERVAL_SECONDS=5
OUTBOUND_MAX_ATTEMPTS=5
OUTBOUND_TIMEOUT_SECONDS=10
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
OUTBOUND_ALLOWED_HOSTS=[]
WEBHOOK_MAX_DELIVERY_ATTEMPTS=6
WEBHOOK_BATCH_SIZE=100
